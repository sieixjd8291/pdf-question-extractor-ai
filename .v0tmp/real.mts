import sharp from 'sharp';
import { buildInkMap, segmentSample } from '../src/lib/handwriting/sampleFont';
const file = process.argv[2] ?? '/tmp/hw/real/clean.png';
const text = process.env.TEXT ?? 'The quick brown fox jumps over the lazy dog\nTHE QUICK BROWN FOX JUMPS OVER THE LAZY DOG\n01234567 89\n! , " \' / ?';
const { data, info } = await sharp(file).ensureAlpha().raw().toBuffer({ resolveWithObject: true });
const ink = buildInkMap({ width: info.width, height: info.height, data: new Uint8ClampedArray(data), colorSpace: 'srgb' } as ImageData);
const big = ink.components.filter((c) => c.area >= 3);
console.log('size', info.width, info.height, 'components', ink.components.length, 'valid', big.length, 'largest', Math.max(...big.map((c) => c.area)));
const t = Date.now();
const seg = segmentSample(ink, text);
console.log('ms', Date.now() - t, 'error', seg.error ?? '-');
for (const r of seg.rows) console.log(JSON.stringify(r.text), r.pieces.map((p) => `${p.y0}-${p.y1}`).slice(0, 6).join(' '));
console.log('missing', (seg.missing ?? []).join(''));
const rects = seg.rows.flatMap((r) => r.pieces.map((p, i) => `<rect x="${p.x0}" y="${p.y0}" width="${p.x1 - p.x0 + 1}" height="${p.y1 - p.y0 + 1}" fill="none" stroke="#06f" stroke-width="2"/><text x="${p.x0}" y="${p.y0 - 3}" font-size="16" fill="#e00">${r.letters[i].replace(/[<&"']/g, '?')}</text>`)).join('');
await sharp(file).composite([{ input: Buffer.from(`<svg xmlns="http://www.w3.org/2000/svg" width="${info.width}" height="${info.height}">${rects}</svg>`) }]).png().toFile(process.env.OUT ?? '/tmp/hw/overlay.png');
